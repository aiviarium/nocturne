{
  "name": "@aiviarium/nocturne",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "gallery": "vite --config gallery/vite.config.ts gallery",
    "gallery:build": "vite build --config gallery/vite.config.ts gallery",
    "demo": "vite --config demo/vite.config.ts demo",
    "demo:build": "vite build --config demo/vite.config.ts demo",
    "examples:build": "vite build --config examples/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "lint:tokens": "bun scripts/lint-tokens.ts",
    "gen:icons": "bun scripts/gen-icons.ts && biome format --write src/components/icon-data.ts",
    "check": "biome ci . && tsc --noEmit && bun test && bun run lint:tokens"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0",
    "@solidjs/web": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@happy-dom/global-registrator": "^20.14.6",
    "@solidjs/compiler": "2.0.2",
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.0",
    "@types/bun": "^1.4.4",
    "lucide": "^1.73.0",
    "solid-js": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/solid": "0.1.0-beta.13",
    "lib0": "^0.2.120",
    "markdown-it": "^15.0.3",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.6.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "^1.42.9",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  }
}
