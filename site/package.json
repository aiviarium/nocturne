{
  "name": "@aiviarium/nocturne-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run prepare:nocturne && next dev",
    "build": "bun run prepare:nocturne && next build",
    "start": "sirv out --port 3000",
    "prepare:nocturne": "bun run gallery && bun run tokens",
    "gallery": "tsx scripts/gallery.ts",
    "tokens": "tsx scripts/nocturne-data.ts",
    "typecheck": "bun run tokens && fumadocs-mdx && next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "links": "tsx scripts/check-links.ts",
    "vale": "cd .. && vale --output=line $(git ls-files --cached --others --exclude-standard '*.md' '*.mdx')",
    "check": "bun run typecheck && bun run lint && bun run links && bun run vale && bun run build",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "fumadocs-core": "16.19.4",
    "fumadocs-mdx": "15.6.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.19.4",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "github-slugger": "^2.0.0",
    "mdx2vast": "^0.5.0",
    "next-validate-link": "^1.6.7",
    "postcss": "^8.5.32",
    "sirv-cli": "^3.0.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9"
  },
  "engines": {
    "node": ">=22"
  }
}
